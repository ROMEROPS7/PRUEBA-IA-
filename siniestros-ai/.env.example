# ==================== Application Settings ====================
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
RELOAD=True
LOG_LEVEL=info

# ==================== Database ====================
# For SQLite (development):
DATABASE_URL=sqlite:///./segurcaixa_siniestros.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/segurcaixa
DATABASE_ECHO=False

# ==================== SMS Configuration (Twilio) ====================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+34912345678

# ==================== Email Configuration (SendGrid) ====================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@segurcaixa.es
EMAIL_FROM_NAME="SegurCaixa Adeslas"

# ==================== WhatsApp Configuration ====================
WHATSAPP_PROVIDER=twilio
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_account_id
WHATSAPP_API_KEY=your_whatsapp_api_key

# ==================== AWS Configuration ====================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==================== Agents Configuration ====================
AGENTS_ENABLED=True
CHAT_AGENT_MODEL=gpt-4
DOCS_AGENT_MODEL=gpt-4-vision
VOICE_AGENT_MODEL=gpt-4
ORCHESTRATOR_AGENT_MODEL=gpt-4

# ==================== File Storage ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ==================== Security ====================
REQUIRE_HTTPS=False
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== Feature Flags ====================
ENABLE_AUTOMATIC_ASSIGNMENT=True
ENABLE_AUTO_APPROVAL=False
ENABLE_MULTI_LANGUAGE=True
ENABLE_ANALYTICS=True
