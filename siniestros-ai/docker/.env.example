# ============================================================================
# SegurCaixa Adeslas - Sistema IA de Siniestros
# Variables de Configuración del Entorno
# ============================================================================

# ============================================================================
# APIs de LLM - Claves de Autenticación
# ============================================================================

# Clave API de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Clave API de OpenAI (GPT-4, etc.)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================================================
# Configuración de N8N
# ============================================================================

# Usuario administrador de N8N
N8N_USER=admin

# Contraseña del usuario administrador de N8N
N8N_PASSWORD=password

# Clave API de N8N para autenticación
N8N_API_KEY=

# URL del webhook para N8N (se recomienda usar la del servidor en producción)
N8N_WEBHOOK_URL=http://api:8000/webhooks/n8n

# ============================================================================
# Configuración de Redis
# ============================================================================

# Contraseña para acceso a Redis (dejar en blanco para sin autenticación)
REDIS_PASSWORD=

# ============================================================================
# Configuración de Base de Datos
# ============================================================================

# URL de conexión a la base de datos
# SQLite (por defecto): sqlite:///./data/siniestros.db
# PostgreSQL: postgresql://usuario:contraseña@localhost:5432/siniestros
DATABASE_URL=sqlite:///./data/siniestros.db

# Tamaño del pool de conexiones
DATABASE_POOL_SIZE=5

# Mostrar SQL en logs (activar solo en desarrollo)
DATABASE_ECHO=false

# ============================================================================
# Configuración de la API
# ============================================================================

# Host donde escucha la API
API_HOST=0.0.0.0

# Puerto de la API
API_PORT=8000

# Modo de recarga automática (solo desarrollo)
API_RELOAD=false

# Nivel de logging
LOG_LEVEL=info

# ============================================================================
# CORS y Seguridad
# ============================================================================

# Orígenes permitidos (CORS) - separar por comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Permitir credenciales en CORS
CORS_CREDENTIALS=true

# ============================================================================
# Agentes IA - Feature Flags
# ============================================================================

# Activar agente de voz (transcripción y análisis de audio)
ENABLE_VOICE_AGENT=true

# Activar agente de documentos (análisis y clasificación de documentos)
ENABLE_DOCUMENT_AGENT=true

# Activar agente de chat (interacción conversacional)
ENABLE_CHAT_AGENT=true

# Activar agente clasificador (clasificación automática de siniestros)
ENABLE_CLASSIFIER_AGENT=true

# Activar agente de asignación (asignación a gestores)
ENABLE_ASSIGNMENT_AGENT=true

# Activar agente orquestador (coordinación de flujos)
ENABLE_ORCHESTRATOR_AGENT=true

# ============================================================================
# Configuración Opcional - Integraciones Externas
# ============================================================================

# URL base para integraciones HTTP
INTEGRATION_BASE_URL=http://api:8000

# Timeout para llamadas HTTP externas (segundos)
HTTP_TIMEOUT=30

# Reintentos automáticos en caso de error
HTTP_RETRIES=3

# ============================================================================
# Configuración Opcional - Notificaciones
# ============================================================================

# URL del servidor SMTP para envío de emails
SMTP_SERVER=

# Puerto del servidor SMTP
SMTP_PORT=587

# Usuario para autenticación SMTP
SMTP_USER=

# Contraseña para autenticación SMTP
SMTP_PASSWORD=

# Emisor de emails
EMAIL_FROM=siniestros@segurcaixa.com

# ============================================================================
# Configuración Opcional - Monitoreo
# ============================================================================

# Activar métricas de Prometheus
ENABLE_METRICS=false

# Puerto para métricas de Prometheus
METRICS_PORT=9090

# Activar envío de trazas a servicio externo
ENABLE_TRACING=false

# URL del servicio de trazas (Jaeger, DataDog, etc.)
TRACING_URL=
